{
  "name": "@frankxai/mcp-doctor",
  "version": "0.4.1",
  "description": "Diagnose, optimize, and manage your Claude Code MCP servers",
  "license": "MIT",
  "author": "FrankX <friemerx@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankxai/mcp-doctor.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "model-context-protocol",
    "audit",
    "developer-tools"
  ],
  "mcpName": "io.github.frankxai/mcp-doctor",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "mcp-doctor": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "audit": "node dist/cli.js audit",
    "recommend": "node dist/cli.js recommend",
    "prepublishOnly": "tsc",
    "verify": "node scripts/release/verify-package.mjs --kind mcp --budget-kb 200",
    "smoke:mcp": "node scripts/release/mcp-stdio-smoke.mjs --expect audit,detect_agents,find_misplaced,recommend -- node dist/cli.js serve",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "^22.9.0",
    "typescript": "~5.9.3"
  }
}
